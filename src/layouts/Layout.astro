---
import '../styles/global.css';
import { Button } from '../components/ui/button';

interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogUrl?: string;
}

const {
  title = 'ISS-in.space — Pass Predictions',
  description = 'Accurate ISS overhead pass predictions for visual observation and amateur radio',
  ogTitle = 'ISS-in.space — Pass Predictions',
  ogDescription = 'Find out when the International Space Station will fly over your location. Free JSON API included.',
  ogUrl = 'https://iss-in.space/',
} = Astro.props;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>{title}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content={description}>
  <meta name="keywords" content="ISS, international space station, passes, predictions, overhead, amateur radio">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="ISS-in.space">
  <meta property="og:url" content={ogUrl}>
  <meta property="og:title" content={ogTitle}>
  <meta property="og:description" content={ogDescription}>
  <meta property="og:image" content="https://iss-in.space/img/og-image.png">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={ogTitle}>
  <meta name="twitter:description" content={ogDescription}>
  <meta name="twitter:image" content="https://iss-in.space/img/og-image.png">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="alternate icon" href="/img/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="/img/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/img/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/img/apple-touch-icon.png">
  <link rel="manifest" href="/img/site.webmanifest">
  <link rel="mask-icon" href="/img/safari-pinned-tab.svg" color="#0b3a82">
  <meta name="theme-color" content="#0b3a82">
  <meta name="msapplication-TileColor" content="#0b3a82">

  <script is:inline>
    (function () {
      var saved = localStorage.getItem('iss-theme');
      var dark = saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.classList.toggle('dark', dark);
    })();
  </script>

  <slot name="head" />
</head>

<body class="min-h-screen flex flex-col">
  <div class="p-4 sm:p-6 max-w-4xl mx-auto w-full flex-auto">
    <header class="mb-8 pb-4 border-b flex items-center justify-between">
      <a href="/" class="no-underline flex items-baseline hover:opacity-80 transition-opacity">
        <span class="text-2xl font-bold tracking-tight text-foreground">ISS</span><span class="text-2xl font-normal text-muted-foreground">-in.space</span>
      </a>
      <Button
        id="theme-toggle"
        onclick="toggleTheme()"
        aria-label="Toggle theme"
        variant="outline"
        size="sm"
      ></Button>
    </header>

    <main>
      <slot />
    </main>
  </div>

  <footer class="p-4 sm:p-6 max-w-4xl mx-auto w-full mt-8 border-t">
    <p class="text-xs text-muted-foreground">
      By <a href="https://github.com/patrickjmcd" class="text-foreground hover:text-primary transition-colors" target="_blank" rel="noopener">patrickjmcd</a>.
      Source on <a href="https://github.com/patrickjmcd/iss-in.space" class="text-foreground hover:text-primary transition-colors" target="_blank" rel="noopener">GitHub</a>.
      TLE data from <a href="https://celestrak.org" class="text-foreground hover:text-primary transition-colors" target="_blank" rel="noopener">Celestrak</a>.
    </p>
  </footer>

  <script is:inline>
    function getEffectiveTheme() {
      return document.documentElement.classList.contains('dark') ? 'dark' : 'light';
    }

    function applyToggleLabel() {
      var btn = document.getElementById('theme-toggle');
      if (!btn) return;
      btn.textContent = getEffectiveTheme() === 'dark' ? '☀ light' : '◑ dark';
    }

    function toggleTheme() {
      var next = getEffectiveTheme() === 'dark' ? 'light' : 'dark';
      document.documentElement.classList.toggle('dark', next === 'dark');
      localStorage.setItem('iss-theme', next);
      applyToggleLabel();
    }

    applyToggleLabel();

    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function () {
      if (!localStorage.getItem('iss-theme')) applyToggleLabel();
    });
  </script>
</body>
</html>
