---
import Layout from '../layouts/Layout.astro';
import { Separator } from '../components/ui/separator';
import { Button } from '../components/ui/button';
import { Input } from '../components/ui/input';

let ipLocation = { lat: null as number | null, lng: null as number | null, tz: '' };

try {
  const cf = (Astro.locals as any).runtime?.cf;
  if (cf?.latitude && cf?.longitude) {
    ipLocation = {
      lat: parseFloat(cf.latitude),
      lng: parseFloat(cf.longitude),
      tz: cf.timezone ?? '',
    };
  }
} catch {}
---

<Layout>
  <!-- Location + CTA -->
  <div class="mb-8">
    <p class="text-xs uppercase tracking-wider text-muted-foreground mb-1">Detected location</p>
    <p class="text-2xl font-bold mb-1 min-h-10" id="location-coords"></p>
    <p class="text-sm text-muted-foreground mb-3" id="location-tz"></p>
    <Button as="a" id="view-passes-btn" style="display:none" size="lg">View Passes &rarr;</Button>
  </div>

  <Separator class="my-8" />

  <!-- Manual coordinates -->
  <div class="mb-8">
    <p class="text-xs uppercase tracking-wider text-muted-foreground mb-3">Enter coordinates manually</p>
    <div class="flex flex-wrap items-end gap-3">
      <div>
        <label class="block text-xs uppercase tracking-wider text-muted-foreground mb-1" for="lat">Latitude</label>
        <Input id="lat" type="number" step="any" min="-90" max="90" placeholder="37.7749" class="w-32" />
      </div>
      <div>
        <label class="block text-xs uppercase tracking-wider text-muted-foreground mb-1" for="lng">Longitude</label>
        <Input id="lng" type="number" step="any" min="-180" max="180" placeholder="-122.4194" class="w-32" />
      </div>
      <Button
        variant="outline"
        onclick="navigateToCoords(document.getElementById('lat').value, document.getElementById('lng').value)"
      >
        Go &rarr;
      </Button>
    </div>
  </div>

  <Separator class="my-8" />

  <!-- About -->
  <div class="mb-8">
    <p class="text-xs uppercase tracking-wider text-muted-foreground mb-3">About</p>
    <p class="text-base leading-relaxed text-muted-foreground mb-3">
      ISS-in.space predicts when the
      <a href="https://en.wikipedia.org/wiki/International_Space_Station" target="_blank" rel="noopener" class="text-primary hover:underline">International Space Station</a>
      will pass overhead at your location for the next 5 days &mdash; useful for both visual observation and amateur radio passes (AOS/LOS times, azimuth, max elevation).
    </p>
    <div class="flex flex-wrap">
      <div class="w-full md:w-1/2 md:pr-3 mb-3">
        <p class="text-xs uppercase tracking-wider text-muted-foreground mb-2">Reading the table</p>
        <ul class="text-sm leading-relaxed text-muted-foreground list-disc pl-4 space-y-1">
          <li><strong class="text-foreground">Rise / Set</strong> &mdash; when the ISS crosses the horizon and in which direction</li>
          <li><strong class="text-foreground">Peak elevation</strong> &mdash; how high it gets; higher = brighter and longer visible. Passes below ~10&deg; are hard to see</li>
          <li><strong class="text-foreground">Distance</strong> &mdash; slant range at peak (line-of-sight, not orbital altitude)</li>
          <li><strong class="text-foreground">Duration</strong> &mdash; total time above the horizon</li>
        </ul>
      </div>
      <div class="w-full md:w-1/2 md:pl-3 md:border-l mb-3">
        <p class="text-xs uppercase tracking-wider text-muted-foreground mb-2">How it works</p>
        <ul class="text-sm leading-relaxed text-muted-foreground list-disc pl-4 space-y-1">
          <li>Orbital data (TLE) is fetched from <a href="https://celestrak.org" target="_blank" rel="noopener" class="text-primary hover:underline">Celestrak</a> and cached for 2 hours</li>
          <li>Pass times are calculated using <a href="https://rhodesmill.org/skyfield/" target="_blank" rel="noopener" class="text-primary hover:underline">Skyfield</a> with the SGP4 propagation model &mdash; the same standard used by NORAD</li>
          <li>All times are localized to your browser&apos;s timezone</li>
        </ul>
      </div>
    </div>
  </div>

  <Separator class="my-8" />

  <!-- API -->
  <div class="mb-8">
    <p class="text-xs uppercase tracking-wider text-muted-foreground mb-3">API</p>
    <p class="text-sm leading-relaxed text-muted-foreground mb-3">
      Pass predictions are available as JSON. No authentication required.
      Rate limited to 30 requests/minute per IP.
    </p>

    <p class="text-xs uppercase tracking-wider text-muted-foreground mb-1">Endpoint</p>
    <pre class="text-sm p-3 rounded-md mb-3 overflow-x-auto bg-card border">GET /api/passes/{'{lat}'}/{'{lng}'}</pre>

    <p class="text-xs uppercase tracking-wider text-muted-foreground mb-1">Example</p>
    <pre class="text-sm p-3 rounded-md mb-3 overflow-x-auto bg-card border">curl https://iss-in.space/api/passes/28.3922/-80.6077</pre>

    <p class="text-xs uppercase tracking-wider text-muted-foreground mb-1">Response</p>
    <pre class="text-sm p-3 rounded-md overflow-x-auto bg-card border">{`[
  {
    "length": 427,
    "length_mins": "7:07",
    "rise":      { "time": "2026-03-27T00:15:22Z", "degrees": 0,  "azimuth": 214, "direction": "SW", "distance": 2621 },
    "culminate": { "time": "2026-03-27T00:18:35Z", "degrees": 43, "azimuth": 142, "direction": "SE", "distance": 559  },
    "set":       { "time": "2026-03-27T00:21:49Z", "degrees": 0,  "azimuth": 71,  "direction": "ENE","distance": 2583 }
  }
]`}</pre>

    <div class="mt-3">
      <p class="text-xs uppercase tracking-wider text-muted-foreground mb-2">Fields</p>
      <table class="text-sm w-full border-collapse text-muted-foreground">
        <tbody>
          <tr class="border-b">
            <td class="py-1 pr-3 font-bold text-foreground whitespace-nowrap">length</td>
            <td class="py-1">Pass duration in seconds</td>
          </tr>
          <tr class="border-b">
            <td class="py-1 pr-3 font-bold text-foreground whitespace-nowrap">length_mins</td>
            <td class="py-1">Pass duration as <code class="text-primary">m:ss</code></td>
          </tr>
          <tr class="border-b">
            <td class="py-1 pr-3 font-bold text-foreground whitespace-nowrap">rise / culminate / set</td>
            <td class="py-1">Event objects, each with <code class="text-primary">time</code> (ISO 8601 UTC), <code class="text-primary">degrees</code> (elevation), <code class="text-primary">azimuth</code> (0&ndash;360&deg;), <code class="text-primary">direction</code> (cardinal), <code class="text-primary">distance</code> (km slant range)</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <script define:vars={{ ipLocation }} is:inline>
    function navigateToCoords(lat, lng) {
      var la = parseFloat(lat), lo = parseFloat(lng);
      if (!isNaN(la) && !isNaN(lo)) window.location = '/passes/' + la + '/' + lo;
    }

    function showLocation(lat, lng, tz) {
      document.getElementById('location-coords').textContent = lat.toFixed(4) + ', ' + lng.toFixed(4);
      document.getElementById('location-tz').textContent = tz || '';
      var btn = document.getElementById('view-passes-btn');
      btn.href = '/passes/' + lat + '/' + lng;
      btn.style.display = '';
    }

    function onGeoSuccess(pos) {
      showLocation(
        pos.coords.latitude,
        pos.coords.longitude,
        Intl.DateTimeFormat().resolvedOptions().timeZone
      );
    }

    function onGeoError() {
      if (ipLocation.lat !== null) {
        showLocation(ipLocation.lat, ipLocation.lng, ipLocation.tz);
      } else {
        document.getElementById('location-coords').textContent = 'Location unavailable';
      }
    }

    if (navigator.geolocation) {
      navigator.geolocation.getCurrentPosition(onGeoSuccess, onGeoError, { timeout: 8000 });
    } else {
      onGeoError();
    }

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') {
        navigateToCoords(
          document.getElementById('lat').value,
          document.getElementById('lng').value
        );
      }
    });
  </script>
</Layout>
